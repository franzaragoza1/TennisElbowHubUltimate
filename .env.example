# Copy this file to `.env` (that exact name: the scripts load it with --env-file=.env)
# and fill in the values. `.env` is never committed.

# Neon (Postgres) connection string. Everyone uses THEIR OWN Neon project, never the
# production one. See README → "Getting started".
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Groq API, for the generated head-to-head copy (lib/h2hNarrative.ts).
# Leave it empty and the site still works; it just loses that copy.
GROQ_API_KEY=

# OpenRouter API (openrouter.ai), for reading a player's Build stats off an uploaded
# Character Sheet screenshot (lib/buildScreenshotOcr.ts) — a vision-capable model,
# unlike GROQ_API_KEY above (Groq's current catalog has no vision model on this
# account). Leave it empty and Build uploads still work; the stats form just isn't
# pre-filled automatically, the player fills it in by hand.
OPENROUTER_API_KEY=

# Auth.js (NextAuth v5) — real user accounts via Discord OAuth. AUTH_SECRET is any
# long random string (signs session tokens); AUTH_DISCORD_ID/AUTH_DISCORD_SECRET come
# from a Discord Application (discord.com/developers/applications) with an OAuth2
# redirect URI of <SITE_URL>/api/auth/callback/discord (locally:
# http://localhost:3000/api/auth/callback/discord).
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Access to the admin panel (/admin) — comma-separated real Discord user ids (not
# usernames; Developer Mode on in Discord → right-click your own name → "Copy User
# ID"), checked against whoever is signed in with Discord (lib/adminSession.ts).
# There's no separate admin password anymore: sign in normally at /admin/login and
# you're in if your id is on this list.
ADMIN_DISCORD_USER_IDS=

# YouTube Data API v3 key, for syncing VODs from @TennisElbowOnlineTour
# (lib/youtube/client.ts). Leave empty and the matching/review pipeline still works
# against fixtures; only the live channel fetch needs this.
YOUTUBE_API_KEY=

# Shared secret the .github/workflows/youtube-sync-cron.yml GitHub Action sends as
# `Authorization: Bearer <value>` when it calls /api/cron/youtube-sync daily (Render's
# free plan has no built-in cron, unlike Vercel). Leave empty and that route stays
# disabled.
CRON_SECRET=

# Shared secret the auto-scraper (scripts/autoScrape.ts, run on a schedule — Docker on
# a home server or Task Scheduler, see Dockerfile/docker-compose.yml) sends as
# `Authorization: Bearer <value>` when it calls /api/scraper/revalidate after each run.
# Leave empty and that route stays disabled.
SCRAPER_SECRET=

# Public URL of the deployed site — needed wherever scripts/autoScrape.ts runs (to POST
# the revalidate webhook) and wherever scripts/discordBot.ts runs (to build each
# player's website-profile link in Discord embeds). Not read by the Next app itself.
SITE_URL=

# scripts/discordBot.ts — a persistent bot process, separate from the site and the
# scraper (see its own file header). DISCORD_BOT_TOKEN and DISCORD_GUILD_ID come from
# the existing Discord Application/bot (discord.com/developers/applications);
# DISCORD_MATCHUPS_CHANNEL_ID and DISCORD_RESULTS_CHANNEL_ID are the ids of the two
# channels it posts to (right-click a channel in Discord with Developer Mode on →
# "Copy Channel ID"). Reuses GROQ_API_KEY above for the AI interview questions and
# SITE_URL above for profile links.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MATCHUPS_CHANNEL_ID=
DISCORD_RESULTS_CHANNEL_ID=

# Awards: voting itself is a real Discord poll, one per category, posted by
# lib/discordBot/tasks/announceAwardsVotingOpened.ts — the site only mirrors it
# read-only and links to it (lib/awards/format.ts::discordPollLink). Optional, unlike
# the two channel ids above: leave DISCORD_AWARDS_CHANNEL_ID empty and every Awards
# bot task simply no-ops, the rest of the bot (and the rest of the site) runs
# normally. Unlike every other Discord var above, DISCORD_BOT_TOKEN, DISCORD_GUILD_ID
# and DISCORD_AWARDS_CHANNEL_ID must ALSO be set in the main Next.js app's own
# environment (Render included) — app/admin/awards/actions.ts::closeVoting ends a
# poll early via a plain REST call from inside the site itself, not through the bot
# process, since ending a poll doesn't need a live gateway connection.
DISCORD_AWARDS_CHANNEL_ID=

# Live board (lib/discordBot/tasks/liveBoard.ts) — shows every currently-live TE4
# match on live-tennis.cn (not just tour matches) plus who's currently looking for an
# opponent, refreshed every 45s in a single edited message. DISCORD_ELBOT_CHANNEL_ID
# is the channel where the third-party "elbot" already posts "wants to play"/"started
# a game" messages (this bot only reads them, never posts there);
# DISCORD_LIVE_BOARD_CHANNEL_ID is a dedicated channel this bot posts/edits its own
# board message in. Both optional — leave either empty and this feature simply
# doesn't run, the rest of the bot works normally.
DISCORD_ELBOT_CHANNEL_ID=
DISCORD_LIVE_BOARD_CHANNEL_ID=

# New-tournament-opened announcements (lib/discordBot/tasks/announceNewTournament.ts)
# — fired once, automatically, the moment an admin adds a brand-new tournament that's
# still in open registration (lib/mana/loadTournament.ts::loadTournamentByExternalId).
# Posted via plain REST, not the gateway client: the caller runs inside the `scraper`
# process (scripts/autoScrape.ts), which never holds a live gateway connection — same
# reasoning as DISCORD_AWARDS_CHANNEL_ID above. Optional — empty and this feature
# simply doesn't post anything, nothing else is affected.
DISCORD_NEW_TOURNAMENT_CHANNEL_ID=

# Moderator deadlines board (lib/discordBot/tasks/moderatorDeadlinesBoard.ts) — a
# single edited message listing every organizing thread that's within 24h of its
# deadline or already past it, flagging the ones with no activity yet (no message from
# either player, no confirm button pressed). DISCORD_MODERATOR_ALERTS_CHANNEL_ID is the
# channel both the board and the one-off pings below go in; DISCORD_MODERATOR_USER_IDS
# is who gets pinged (comma-separated Discord user ids), pinged once per match the
# first time it becomes overdue-or-close-to-deadline AND undiscussed, never repeated.
# Both optional — leave either empty and this feature simply doesn't run.
DISCORD_MODERATOR_ALERTS_CHANNEL_ID=
DISCORD_MODERATOR_USER_IDS=

# Achievement-role sync (lib/discordBot/tasks/syncRoles.ts) — all optional, unlike
# everything else above: with any of these unset, that specific role is simply never
# assigned, the rest of the bot (announcements, reminders) runs completely normally.
# Same "Copy Role ID" flow as the channel ids above, applied to each role instead.
# WORLD_NO_1 is a live status (only the current #1 holds it, reassigned automatically
# every week); the rest are permanent achievements, granted once and never revoked.
DISCORD_ROLE_TOUR_PLAYER=
DISCORD_ROLE_WORLD_NO_1=
DISCORD_ROLE_GRAND_SLAM_CHAMPION=
DISCORD_ROLE_TOUR_FINALS_CHAMPION=
DISCORD_ROLE_MASTERS_1000_CHAMPION=
DISCORD_ROLE_500_CHAMPION=
DISCORD_ROLE_250_CHAMPION=
DISCORD_ROLE_CHALLENGER_CHAMPION=
DISCORD_ROLE_FUTURES_CHAMPION=
DISCORD_ROLE_MASTER_PREDICTOR=
DISCORD_ROLE_BELIEVER=
DISCORD_ROLE_PROPHET=
DISCORD_ROLE_PERFECT_BRACKET=
DISCORD_ROLE_STARTER=
DISCORD_ROLE_ARTICLES_WRITER=

# Web Push (VAPID) — lets the site send real device push notifications (followed
# player/tournament goes live or finishes, someone replies to your topic/comment).
# Generate a pair once with `npx web-push generate-vapid-keys`; VAPID_SUBJECT is a
# `mailto:` address a push service can contact if it has concerns about your traffic.
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is the same value as VAPID_PUBLIC_KEY, exposed to the
# browser for `PushManager.subscribe` — Next.js inlines NEXT_PUBLIC_* vars at build
# time, so it can't just read VAPID_PUBLIC_KEY server-side. Leave all four empty and
# the site works normally; push notifications are simply never sent, and the in-site
# notification bell still works off `notifications` rows alone.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Cloudflare R2 (S3-compatible, zero egress fees) — ver lib/mediaStorage.ts. Reemplaza
# el guardado de imágenes de noticias/avatares como data URI en base64 (bug real de
# ancho de banda, 2026-09-20): ahora se suben aquí y solo se guarda la URL pública.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=
