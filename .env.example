# Copia este fichero a `.env` (ese nombre exacto: los scripts usan --env-file=.env)
# y rellena los valores. `.env` nunca se sube a git.

# Cadena de conexión de Neon (Postgres). Cada persona usa SU PROPIO proyecto de Neon,
# nunca el de producción. Ver README → "Puesta en marcha".
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# API de Groq, para los textos generados del H2H (lib/h2hNarrative.ts).
# Si lo dejas vacío la web funciona; solo se queda sin ese texto.
GROQ_API_KEY=

# Acceso al panel de administración (/admin). En local pon lo que quieras.
ADMIN_PASSWORD=
# Secreto para firmar la cookie de sesión de admin. Cualquier cadena larga y aleatoria.
ADMIN_SECRET=
