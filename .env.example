# Copy this file to `.env` (that exact name: the scripts load it with --env-file=.env)
# and fill in the values. `.env` is never committed.

# Neon (Postgres) connection string. Everyone uses THEIR OWN Neon project, never the
# production one. See README → "Getting started".
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Groq API, for the generated head-to-head copy (lib/h2hNarrative.ts).
# Leave it empty and the site still works; it just loses that copy.
GROQ_API_KEY=

# Access to the admin panel (/admin). Locally, set it to whatever you like.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=
