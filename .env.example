# Copy this file to `.env` (that exact name: the scripts load it with --env-file=.env)
# and fill in the values. `.env` is never committed.

# Neon (Postgres) connection string. Everyone uses THEIR OWN Neon project, never the
# production one. See README → "Getting started".
DATABASE_URL=postgresql://user:password@ep-example-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Groq API, for the generated head-to-head copy (lib/h2hNarrative.ts).
# Leave it empty and the site still works; it just loses that copy.
GROQ_API_KEY=

# Access to the admin panel (/admin). Locally, set it to whatever you like.
ADMIN_PASSWORD=
# Secret used to sign the admin session cookie. Any long random string.
ADMIN_SECRET=

# Auth.js (NextAuth v5) — real user accounts via Discord OAuth. AUTH_SECRET is any
# long random string (signs session tokens); AUTH_DISCORD_ID/AUTH_DISCORD_SECRET come
# from a Discord Application (discord.com/developers/applications) with an OAuth2
# redirect URI of <SITE_URL>/api/auth/callback/discord (locally:
# http://localhost:3000/api/auth/callback/discord).
AUTH_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# YouTube Data API v3 key, for syncing VODs from @TennisElbowOnlineTour
# (lib/youtube/client.ts). Leave empty and the matching/review pipeline still works
# against fixtures; only the live channel fetch needs this.
YOUTUBE_API_KEY=

# Shared secret Vercel Cron sends as `Authorization: Bearer <value>` when it calls
# /api/cron/youtube-sync (see vercel.json). Leave empty and that route stays disabled.
CRON_SECRET=

# Shared secret the local auto-scraper (scripts/autoScrape.ts, run on a schedule via
# Task Scheduler) sends as `Authorization: Bearer <value>` when it calls
# /api/scraper/revalidate after each run. Leave empty and that route stays disabled.
SCRAPER_SECRET=

# Public URL of the deployed site — needed wherever scripts/autoScrape.ts runs (to POST
# the revalidate webhook) and wherever scripts/discordBot.ts runs (to build each
# player's website-profile link in Discord embeds). Not read by the Next app itself.
SITE_URL=

# scripts/discordBot.ts — a persistent bot process, separate from the site and the
# scraper (see its own file header). DISCORD_BOT_TOKEN and DISCORD_GUILD_ID come from
# the existing Discord Application/bot (discord.com/developers/applications);
# DISCORD_MATCHUPS_CHANNEL_ID and DISCORD_RESULTS_CHANNEL_ID are the ids of the two
# channels it posts to (right-click a channel in Discord with Developer Mode on →
# "Copy Channel ID"). Reuses GROQ_API_KEY above for the AI interview questions and
# SITE_URL above for profile links — nothing else from the main app's .env is needed
# on the machine running this.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_MATCHUPS_CHANNEL_ID=
DISCORD_RESULTS_CHANNEL_ID=
